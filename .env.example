# AWS MVP integration environment example
# Copy to .env and fill only the secret placeholders.
# Never commit the real .env file.

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=one_cycle
POSTGRES_USER=one_cycle
POSTGRES_PASSWORD=CHANGE_ME

# Embedding
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_PATH=/path/to/models/embedding/bge-m3
EMBEDDING_USE_FP16=true
EMBEDDING_REQUIRE_CUDA=true
EMBEDDING_DEVICE_INDEX=0

# llama.cpp / LLM
LLAMA_BASE_URL=http://127.0.0.1:8080
LLAMA_MODEL=gemma
LLAMA_TIMEOUT_SECONDS=600
LLAMA_TEMPERATURE=0.0
LLAMA_TOP_P=1.0
LLAMA_MAX_TOKENS=1024
LLAMA_MAX_CONTEXT_CHARS=6000
LLAMA_CONTEXT_TOP_K=5

# Internal HTTP Services (Docker API version)
# Service hostname and port are finalized in Docker Compose.
RAG_SERVICE_BASE_URL=
RAG_SERVICE_TIMEOUT_SECONDS=60

DOCUMENT_WORKER_BASE_URL=
DOCUMENT_WORKER_TIMEOUT_SECONDS=600

# Legacy in-process RAG connection
# HTTP ?? ?? ? ?? ??
# RAG
RAG_ANSWER_FUNCTION=rag.service:answer_question
MVP_ANNOUNCEMENT_ID=1
MVP_DOCUMENT_FORMAT=hwpx

# Admin
ADMIN_ID=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME

# Admin session / cookie
ADMIN_JWT_EXPIRE_SECONDS=3600
ADMIN_COOKIE_NAME=admin_access_token
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAMESITE=lax
RAG_DB_TOP_K=5

# Backend pipeline gateway
# Enable only callables that are implemented and verified.
COLLECTION_RUNNER=backend.app.services.integration_service:collect_persist_and_process
ANNOUNCEMENT_RECOLLECTOR=backend.app.services.integration_service:recollect_persist_and_process

# Document processing runtime:
# legacy      = existing Python callable
# worker_http = Document Worker HTTP orchestration
# Keep legacy until the Worker completed-response path is ready.
DOCUMENT_PROCESSING_RUNTIME=legacy
DOCUMENT_REPROCESSOR=pipeline.document_processor:reprocess_document

# Connect after the external callable is implemented and verified.
# ERROR_RETRY_RUNNER=
